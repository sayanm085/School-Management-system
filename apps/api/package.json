{
  "name": "baranda-api",
  "version": "0.1.0",
  "private": true,
  "description": "Baranda school operations API",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.cli.ts",
    "db:seed": "tsx src/db/seed.cli.ts",
    "openapi:generate": "nest build && node dist/openapi.cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "nestjs-zod": "^5.5.0",
    "otplib": "^12.0.1",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@swc/core": "^1.13.5",
    "@types/node": "^24.9.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fastify": "5.12.7",
    "js-yaml": "^5.5.0"
  }
}
